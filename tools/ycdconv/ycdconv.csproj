<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converts Sollumz .ycd.xml clip dictionaries to binary .ycd using CodeWalker.Core (MIT-style licence).
       Needs the CodeWalker source (a shallow git clone of github.com/dexyfex/CodeWalker)
       in tools/downloads/CodeWalker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\downloads\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
